{
  "title": "APIX Gateway Dashboard",
  "uid": "apix-gateway-dash",
  "panels": [
    {
      "title": "Total Traffic (Requests/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(apix_http_requests_total[1m])",
          "legendFormat": "{{method}} {{status}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "Latency (Avg)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "apix_http_request_duration_seconds",
          "legendFormat": "Avg Latency (s)"
        },
        {
          "expr": "apix_http_request_duration_seconds_max",
          "legendFormat": "Max Latency (s)"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "Plugin Overhead (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "apix_plugin_duration_seconds * 1000",
          "legendFormat": "{{plugin}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "title": "Total Traffic vs Errors",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(apix_http_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "5xx Errors"
        },
        {
          "expr": "sum(rate(apix_http_requests_total{status=~\"4..\"}[1m]))",
          "legendFormat": "4xx Errors"
        },
        {
          "expr": "sum(rate(apix_http_requests_total{status=~\"2..\"}[1m]))",
          "legendFormat": "2xx Success"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ],
  "schemaVersion": 38,
  "timezone": "browser"
}
