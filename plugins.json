{
  "cors": {
    "enabled": true,
    "origin": "*"
  },
  "metrics": {
    "enabled": true
  },
  "request-id": {
    "enabled": true,
    "headerName": "x-request-id"
  },
  "rate-limiter": {
    "enabled": true,
    "windowMs": 60000,
    "maxRequests": 100,
    "algorithm": "fixed",
    "keyStrategy": "ip",
    "forceMemory": true
  },
  "llm-token-counter": {
    "enabled": true,
    "encoding": "cl100k_base",
    "modelEncodings": {
      "gpt-4o": "o200k_base",
      "gpt-4o-mini": "o200k_base",
      "gpt-4": "cl100k_base",
      "gpt-3.5-turbo": "cl100k_base",
      "claude-3-5-sonnet": "cl100k_base",
      "claude-3-opus": "cl100k_base"
    },
    "defaultBudget": 8192,
    "enforceBudget": true,
    "onBudgetExceeded": "reject"
  },
  "routes": {
    "/users": {
      "plugins": {
        "cors": {
          "enabled": true
        },
        "rate-limiter": {
          "enabled": true,
          "windowMs": 60000,
          "maxRequests": 50
        }
      }
    },
    "/admin": {
      "plugins": {
        "request-id": {
          "enabled": true
        },
        "metrics": {
          "enabled": true
        }
      }
    }
  }
}